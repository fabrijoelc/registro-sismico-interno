<%@ include file="cabecera.jspf" %>
<nav class="migas"><a href="${pageContext.request.contextPath}/sismos">Reportes sísmicos</a><span>/</span><span>Detalle</span></nav>
<div class="encabezado-pagina"><div><p class="sobrelinea">REPORTE #${sismo.id}</p><h1><c:out value="${sismo.codigo}"/></h1><p class="subtitulo">Información registrada para revisión interna.</p></div><span class="estado estado-grande"><c:out value="${sismo.estado.etiqueta}"/></span></div>
<c:if test="${param.creado eq '1'}"><div class="aviso exito" role="status">Reporte creado correctamente.</div></c:if>
<c:if test="${param.editado eq '1'}"><div class="aviso exito" role="status">Cambios guardados correctamente.</div></c:if>
<section class="tarjeta detalle-tarjeta"><h2>Datos del reporte</h2><dl class="detalle-grid"><div><dt>ID interno</dt><dd>${sismo.id}</dd></div><div><dt>Código</dt><dd><c:out value="${sismo.codigo}"/></dd></div><div><dt>Fecha y hora</dt><dd><c:out value="${sismo.fechaHoraTexto}"/></dd></div><div><dt>Ubicación</dt><dd><c:out value="${sismo.ubicacion}"/></dd></div><div><dt>Magnitud</dt><dd><c:out value="${sismo.magnitud}"/></dd></div><div><dt>Profundidad</dt><dd><c:out value="${sismo.profundidadKm}"/> km</dd></div><div><dt>Estado</dt><dd><c:out value="${sismo.estado.etiqueta}"/></dd></div><div class="ancho-completo"><dt>Observaciones</dt><dd><c:out value="${empty sismo.observaciones ? 'Sin observaciones' : sismo.observaciones}"/></dd></div></dl>
<div class="botonera"><a class="boton primario" href="${pageContext.request.contextPath}/sismos/editar?id=${sismo.id}">Editar</a><a class="boton peligro" href="${pageContext.request.contextPath}/sismos/eliminar?id=${sismo.id}">Eliminar</a><a class="boton secundario" href="${pageContext.request.contextPath}/sismos">Volver al listado</a></div></section>
<%@ include file="pie.jspf" %>
